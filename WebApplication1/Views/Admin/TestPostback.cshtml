@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Postback Test Aləti</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container my-5" style="max-width: 800px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>🧪 Daxili Postback Test Aləti</h2>
            <a href="/admin/dashboard" class="btn btn-outline-secondary">← Panələ Qayıt</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Test Formu -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Simulyasiya Formu</h5>
            </div>
            <div class="card-body">
                <form action="/admin/test-postback" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Klik Tokeni (SubID)</label>
                        <input type="text" name="token" class="form-control font-monospace" placeholder="Məs: 3fa85f64-5717-4562-b3fc-2c963f66afa6" required />
                        <small class="text-muted">Aşağıdakı son kliklər siyahısından istənilən tokeni kopyalayıb bura yapışdıra bilərsiniz.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Konversiya Növü</label>
                        <select name="type" class="form-select" required>
                            <option value="reg">Qeydiyyat (Reg)</option>
                            <option value="ftd">Depozit / FTD</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Məbləğ / Payout (AZN)</label>
                        <input type="number" step="0.01" name="payout" class="form-control" value="50.00" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2">Test Postback Göndər</button>
                </form>
            </div>
        </div>

        <!-- Son Kliklər Siyahısı (Tokenləri rahat götürmək üçün) -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">📋 Son Klik Edən İstifadəçilər (Token Kopyalamaq Üçün)</h5>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Vaxt</th>
                            <th>Kazino</th>
                            <th>Token (Kopyala)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var click in ViewBag.RecentClicks)
                        {
                            <tr>
                                <td>@click.ClickedAt.ToString("HH:mm:ss")</td>
                                <td>@click.Casino?.Name</td>
                                <td><code style="user-select: all; cursor: pointer;" title="Kopyalamaq üçün klikləyin">@click.Token</code></td>
                                <td>
                                    @if (click.IsDeposited)
                                    {
                                        <span class="badge bg-success">FTD</span>
                                    }
                                    else if (click.IsRegistered)
                                    {
                                        <span class="badge bg-info">Reg</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Klik</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>