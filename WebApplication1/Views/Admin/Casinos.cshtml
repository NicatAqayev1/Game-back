@model IEnumerable<WebApplication1.Models.Casino>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kazinoların İdarə Edilməsi</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark text-light">
    <div class="container my-5">
        <!-- Başlıq və Düymələr -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-white fw-bold">🎰 Kazino Brendləri</h2>
            <div class="d-flex gap-2">
                <a asp-controller="admin" asp-action="dashboard" class="btn btn-outline-light">← Panələ Qayıt</a>
                <a href="/admin/create" class="btn btn-success">+ Yeni Kazino Əlavə Et</a>
                <a href="/admin/logout" class="btn btn-outline-danger">Çıxış Et</a>
            </div>
        </div>

        <!-- Cədvəl Kartı -->
        <div class="card bg-black border-secondary shadow-lg">
            <div class="card-body table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-secondary text-uppercase fs-7">
                            <th scope="col">ID</th>
                            <th scope="col">Brend Adı</th>
                            <th scope="col">Slug (URL kəsimi)</th>
                            <th scope="col">Affiliate Link</th>
                            <th scope="col" class="text-end">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">@item.Id</td>
                                    <td><strong class="text-white">@item.Name</strong></td>
                                    <td><code class="text-info bg-dark px-2 py-1 rounded">/go/@item.Slug</code></td>
                                    <td><small class="text-secondary text-truncate d-inline-block" style="max-width: 250px;">@item.AffiliateUrl</small></td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="/admin/casinos/edit/@item.Id" class="btn btn-sm btn-warning fw-semibold">Düzəliş et</a>
                                            <form action="/admin/casinos/delete/@item.Id" method="post" onsubmit="return confirm('Bu kazinonu silməyə əminsiniz?');" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger fw-semibold">Sil</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Heç bir kazino tapılmadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>