@model IEnumerable<WebApplication1.Models.Casino>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Kazinoların İdarə Edilməsi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <a href="/admin/logout" class="btn btn-outline-danger">Çıxış Et</a>
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>🎰 Kazino Brendləri</h2>
            <div>
                <a href="/admin/dashboard" class="btn btn-outline-secondary me-2">← Panələ Qayıt</a>
                <a href="/admin/casinos/create" class="btn btn-primary">+ Yeni Kazino Əlavə Et</a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Brend Adı</th>
                            <th>Slug (URL kəsimi)</th>
                            <th>Affiliate Link</th>
                            <th>Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td><code>/go/@item.Slug</code></td>
                                <td><small class="text-muted">@item.AffiliateUrl</small></td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="/admin/casinos/edit/@item.Id" class="btn btn-sm btn-warning">Düzəliş et</a>
                                        <form action="/admin/casinos/delete/@item.Id" method="post" onsubmit="return confirm('Bu kazinonu silməyə əminsiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>