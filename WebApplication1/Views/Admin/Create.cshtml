@model WebApplication1.Models.Casino
@{
    ViewData["Title"] = "Yeni Kazino Əlavə Et";
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni Kazino Əlavə Et</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark text-light">
    <div class="container" style="max-width: 650px; padding: 40px 0;">
        <h2 class="text-white fw-bold mb-3">🎰 Yeni Kazino Əlavə Et</h2>
        
        <form asp-action="Create" method="post" style="background: rgba(17, 21, 34, 0.95); padding: 24px; border-radius: 12px; border: 1px solid #1e2638; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
            @Html.AntiForgeryToken()
            
            <!-- Validasiya Xətaları Ümumi Siyahısı -->
            <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 13px;"></div>
            
            <!-- Kazino Adı -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Kazino Adı *</label>
                <input asp-for="Name" class="form-control bg-black text-light border-secondary" placeholder="Məsələn: 1xBet Kazino" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Slug -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Slug (URL kəsimi)</label>
                <input asp-for="Slug" class="form-control bg-black text-light border-secondary" placeholder="Boş buraxarsanız adından avtomatik yaradılacaq (məs: 1xbet)" />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>

            <!-- Loqo Qısaltması və Rəngi -->
            <div class="row mb-3">
                <div class="col-md-8">
                    <label class="form-label text-secondary small">Loqo Qısaltması</label>
                    <input asp-for="LogoText" class="form-control bg-black text-light border-secondary" placeholder="Məsələn: 1X" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-secondary small">Loqo Rəngi</label>
                    <input asp-for="LogoColor" type="color" class="form-control form-control-color bg-black border-secondary w-100" style="height: 38px;" value="#a855f7" />
                </div>
            </div>

            <!-- Reytinq və Promo Kod -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-secondary small">Reytinq (1.0 - 5.0)</label>
                    <input asp-for="Rating" type="number" step="0.1" min="1.0" max="5.0" class="form-control bg-black text-light border-secondary" placeholder="4.9" />
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-secondary small">Promo Kod</label>
                    <input asp-for="PromoCode" class="form-control bg-black text-light border-secondary" placeholder="Məsələn: BONUS2026" />
                </div>
            </div>

            <!-- Bonus Başlığı -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Bonus Başlığı</label>
                <input asp-for="BonusTitle" class="form-control bg-black text-light border-secondary" placeholder="Məsələn: Xoş Gəldin Paketi" />
            </div>

            <!-- Bonus Dəyəri -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Bonus Dəyəri</label>
                <input asp-for="BonusValue" class="form-control bg-black text-light border-secondary" placeholder="Məsələn: 1500 EUR + 150 FS" />
            </div>

            <!-- Affiliate Link -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Affiliate Link *</label>
                <input asp-for="AffiliateUrl" class="form-control bg-black text-light border-secondary" placeholder="https://partner-link.com/..." required />
                <span asp-validation-for="AffiliateUrl" class="text-danger small"></span>
            </div>

            <!-- Kateqoriyalar -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Kateqoriyalar</label>
                <input asp-for="Categories" class="form-control bg-black text-light border-secondary" placeholder="slots, live, sports, instant" />
            </div>

            <!-- İP Whitelist (Sizin modeldə var) -->
            <div class="mb-3">
                <label class="form-label text-secondary small">Icazə verilən IP-lər (Allowed IPs - Postback üçün)</label>
                <input asp-for="AllowedIPs" class="form-control bg-black text-light border-secondary" placeholder="Məsələn: 192.168.1.1, 10.0.0.5 (Boş olsa hamısına icazə var)" />
            </div>

            <!-- IsFeatured (Ayın Təklifi) -->
            <div class="mb-4 form-check">
                <input asp-for="IsFeatured" class="form-check-input bg-black border-secondary" type="checkbox" id="isFeaturedCheck" />
                <label class="form-check-label text-light" for="isFeaturedCheck">
                    Ayın Təklifidirmi? (TOP Kazino kimi göstər)
                </label>
            </div>

            <!-- Yadda Saxla Düyməsi -->
            <button type="submit" class="btn w-100 fw-bold py-2" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #0f172a; border: none;">
                Kazino Əlavə Et
            </button>
        </form>
        
        <div class="mt-3">
            <a asp-action="Index" class="text-secondary text-decoration-none small">← Geri qayıt</a>
        </div>
    </div>
</body>
</html>