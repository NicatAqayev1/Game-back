@model IEnumerable<WebApplication1.Models.Casino>
@{
    ViewData["Title"] = "Admin Paneli";
    var clickCounts = ViewBag.ClickCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<div class="container" style="padding: 40px 0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2><i class="fa-solid fa-gauge-high" style="color:var(--gold);"></i> Admin Paneli - Kazino İdarəetməsi</h2>
        <a asp-action="Create" style="background: var(--neon-green); color: #0f172a; padding: 10px 18px; border-radius: 8px; font-weight: 800; font-size:13px;">+ Yeni Kazino Əlavə Et</a>
    </div>

    <div style="background: rgba(17, 21, 34, 0.9); border: 1px solid #1e2638; border-radius: 12px; overflow-x: auto; padding: 15px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; color: #fff; font-size: 14px;">
            <thead>
                <tr style="border-bottom: 1px solid #1e2638; color: #9ca3af;">
                    <th style="padding: 12px;">Kazino Adı</th>
                    <th style="padding: 12px;">Reytinq</th>
                    <th style="padding: 12px;">Bonus</th>
                    <th style="padding: 12px;">Promo Kod</th>
                    <th style="padding: 12px;">Ümumi Klik</th>
                    <th style="padding: 12px; text-align: right;">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    int clicks = clickCounts.ContainsKey(item.Id) ? clickCounts[item.Id] : 0;
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <td style="padding: 12px; display: flex; align-items: center; gap: 10px;">
                            <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.05); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: @item.LogoColor;">@item.LogoText</div>
                            <strong>@item.Name</strong>
                        </td>
                        <td style="padding: 12px; color: var(--gold);"><i class="fa-solid fa-star"></i> @item.Rating</td>
                        <td style="padding: 12px;">@item.BonusValue</td>
                        <td style="padding: 12px; font-family: monospace; color: var(--gold);">@item.PromoCode</td>
                        <td style="padding: 12px; font-weight: bold; color: var(--neon-cyan);">@clicks klik</td>
                        <td style="padding: 12px; text-align: right;">
                            <a asp-action="Edit" asp-route-id="@item.Id" style="color: var(--neon-cyan); margin-right: 12px; font-size:13px;"><i class="fa-solid fa-pen"></i> Redaktə</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Bu kazinonu silmək istədiyinizə əminsiniz?');" style="color: #ff3366; font-size:13px;"><i class="fa-solid fa-trash"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="margin-top: 20px;">
        <a href="/" style="color: #9ca3af; font-size: 13px;"><i class="fa-solid fa-arrow-left"></i> Sayta qayıt</a>
    <a asp-action="Logout" style="color: #ff3366; font-size: 13px; margin-left: 15px;"><i class="fa-solid fa-right-from-bracket"></i> Çıxış</a>

    </div>
</div>