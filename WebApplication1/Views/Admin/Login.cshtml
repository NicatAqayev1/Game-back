@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Admin Girişi - iGaming Affiliate</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-lg p-4" style="width: 400px; border-radius: 12px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold">🔐 Admin Panel</h3>
            <p class="text-muted">Davam etmək üçün daxil olun</p>
        </div>

        <form action="/admin/login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">İstifadəçi Adı</label>
                <input type="text" name="username" class="form-control" required autofocus />
            </div>

            <div class="mb-3">
                <label class="form-label">Şifrə</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3">
                    <small>İstifadəçi adı və ya şifrə səhvdir!</small>
                </div>
            }

            <button type="submit" class="btn btn-primary w-100 py-2">Daxil Ol</button>
        </form>
    </div>

</body>
</html>