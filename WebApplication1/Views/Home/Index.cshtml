                            <span class="tag"><i class="fa-solid fa-check" style="color:var(--neon-green)"></i> Yüksək Əmsallar</span>
                            <span class="tag"><i class="fa-solid fa-check" style="color:var(--neon-green)"></i> Aviator Hədiyyə</span>
                        </div>
                    </div>
                    <div>
                        <div class="promo-bar">
                            <span style="color:var(--text-muted)">Promokod:</span>
                            <span class="promo-code">MOSTVIP</span>
